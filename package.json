{
  "name": "wifu-engine",
  "version": "1.0.3",
  "description": "A simple transparent overlay creator for Windows / MacOS / Linux using Electron.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"next dev -p 3000\" \"wait-on tcp:3000 && electron .\"",
    "dev:next": "next dev -p 3000",
    "dev:electron": "electron .",
    "build:renderer": "next build",
    "build:electron": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win -c.win.signAndEditExecutable=false",
    "build": "next build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win -c.win.signAndEditExecutable=false",
    "start": "electron ."
  },
  "keywords": [],
  "author": "lungiman",
  "license": "ISC",
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.475.0",
    "next": "^15.1.0",
    "postcss": "^8.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.lungiman.wifu-engine",
    "productName": "Wifu Engine",
    "files": [
      "electron/**/*",
      "out/**/*",
      "icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png"
    }
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.38.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  }
}